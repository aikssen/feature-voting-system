# syntax=docker/dockerfile:1
#
# Production image, for exposure beyond the LAN. DECISIONS.md C5 keeps the Vite dev
# server as the default `docker compose up` path for review; this file exists because
# a dev server cannot face the Internet. See DECISIONS.md A1.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app

# Deps first so they cache across source edits. pnpm-workspace.yaml carries
# allowBuilds for the esbuild / @tailwindcss/oxide native postinstalls.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Vite bakes this at build time. The default is relative on purpose: the same image
# then works on any hostname, because Caddy serves the API under the same origin.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN pnpm build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80

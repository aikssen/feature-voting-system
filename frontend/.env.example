# SoundFlow frontend configuration (see DECISIONS.md D-ENV).
# Only needed when running Vite natively — under Docker Compose these values come
# from the root .env (VITE_API_BASE_URL, and LOG_LEVEL mirrored to VITE_LOG_LEVEL).

# Base URL of the backend REST API — must point at the PUBLISHED backend port.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Client-side log verbosity: debug | info | warn | error | silent.
VITE_LOG_LEVEL=info

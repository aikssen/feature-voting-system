# SoundFlow configuration (see DECISIONS.md D-ENV).
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
#
# docker-compose.yml auto-loads this file for ${VAR} substitution and passes it to
# the containers.
#
# PORTS: container ports are fixed (3000 / 5432 / 5173). The *_PORT vars below only
# choose the HOST port Compose publishes, so you can run several stacks side by side
# without collisions. Changing them never requires touching the app or Dockerfiles.

# --- Postgres (used by the db service and to build the backend DATABASE_URL) ---
POSTGRES_USER=soundflow
POSTGRES_PASSWORD=soundflow
POSTGRES_DB=soundflow

# Host port for the db container. Bump it if you already run Postgres on 5432.
DATABASE_PORT=5432

# --- Backend ---
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=24

# Host port for the API. The container always binds 3000 (Compose pins it).
BACKEND_PORT=3000

# Must list the origin the browser loads the frontend from (FRONTEND_PORT below).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DATABASE_URL is only for running the backend natively (without Docker), where
# Postgres is on localhost — use DATABASE_PORT as the port. Under Docker Compose it
# is built automatically from the POSTGRES_* vars with the `db` service as host.
#DATABASE_URL=postgres://soundflow:soundflow@localhost:5432/soundflow?sslmode=disable

# --- Frontend ---
# Host port for the Vite dev server. The container always binds 5173.
FRONTEND_PORT=5173

# The browser runs on the host, so it must target the PUBLISHED backend port
# (BACKEND_PORT above), not the container's 3000.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Observability (see DECISIONS.md D-LOG) ---
# One knob for the whole stack: debug | info | warn | error.
# Compose mirrors it into VITE_LOG_LEVEL for the frontend.
LOG_LEVEL=info
